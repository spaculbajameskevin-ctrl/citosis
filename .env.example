DEBUG=True
SECRET_KEY=change-me
ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Manila
USE_SQLITE=True
APP_URL=http://localhost:8000

# Gmail SMTP (use an App Password, not your normal password)
EMAIL_DELIVERY_METHOD=smtp
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=your@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=CITOSIS PRO <your@gmail.com>

# Resend Email API (recommended for Render Free)
RESEND_API_KEY=
RESEND_API_URL=https://api.resend.com/emails

# Super Admin login protection
REQUIRE_SUPER_ADMIN_2FA=True

# Optional deploy-time admin bootstrap
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin
ADMIN_NAME=System Administrator
ADMIN_OFFICE=Tourism Office

DB_NAME=citosis_pro
DB_USER=root
DB_PASSWORD=secret
DB_HOST=127.0.0.1
DB_PORT=3306
